{%- set pageUrl = site.url + site.baseUrl + page.url -%}
{%- set imageUrl = image | imageUrl -%}
{%- set totalMinutes = (recipeContent.prepTimeMinutes or 0) + (recipeContent.cookTimeMinutes or 0) -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} — {{ site.title }}</title>
<meta name="description" content="{{ description }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:type" content="article">
{% if imageUrl %}<meta property="og:image" content="{{ imageUrl }}">{% endif %}
<link rel="canonical" href="{{ pageUrl }}">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="stylesheet" href="../style.css?v=2">
{% include "partials/tracking.njk" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": {{ title | dump | safe }},
  {% if imageUrl %}"image": [{{ imageUrl | dump | safe }}],{% endif %}
  "description": {{ description | dump | safe }},
  "prepTime": "{{ recipeContent.prepTimeMinutes | isoDuration }}",
  "cookTime": "{{ recipeContent.cookTimeMinutes | isoDuration }}",
  "totalTime": "{{ totalMinutes | isoDuration }}",
  "recipeYield": {{ (recipeContent.servingsNumber ~ " " ~ recipeContent.servingsUnit) | dump | safe }},
  "recipeCategory": {{ category | dump | safe }},
  "recipeCuisine": "American",
  "recipeIngredient": [
    {% for ing in recipeContent.ingredients %}{{ (ing.amount + " " + ing.item if ing.amount else ing.item) | trim | dump | safe }}{% if not loop.last %},{% endif %}
    {% endfor %}
  ],
  "recipeInstructions": [
    {% for step in recipeContent.steps %}{ "@type": "HowToStep", "text": {{ step | dump | safe }} }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
</head>
<body>

<div class="wrap recipe-header">
  <a class="back-link" href="../index.html">&larr; {{ site.title }}</a>
  <span class="eyebrow">{{ category }}{% if tag %} · {{ tag }}{% endif %}</span>
  <h1>{{ title }}</h1>
  <p class="lede">{{ description }}</p>
</div>

<div class="wrap">
  {% if imageUrl %}
  <img class="hero-photo" src="{{ imageUrl }}" alt="{{ title }}" style="width:100%; object-fit:cover;">
  {% else %}
  <div class="hero-photo"></div>
  {% endif %}

  <div class="pin-save-row">
    <a class="btn-line" data-pin-do="buttonPin" data-pin-custom="true"
       href="https://www.pinterest.com/pin/create/button/?url={{ pageUrl | urlencode }}&media={{ imageUrl | urlencode }}&description={{ description | urlencode }}">
      Save to Pinterest
    </a>
  </div>

  <div class="stat-strip">
    <div class="stat"><span class="num">{{ recipeContent.prepTimeMinutes }}m</span><span class="label">Prep</span></div>
    <div class="stat"><span class="num">{{ recipeContent.cookTimeMinutes }}m</span><span class="label">Cook</span></div>
    <div class="stat"><span class="num">{{ totalMinutes }}m</span><span class="label">Total</span></div>
    <div class="stat"><span class="num">{{ recipeContent.servingsNumber }}</span><span class="label">{{ recipeContent.servingsUnit }}</span></div>
  </div>

  <div class="recipe-body">
    <aside class="ingredients">
      <h2>Ingredients</h2>
      <ul>
        {% for ing in recipeContent.ingredients %}
        <li><span class="amt">{{ ing.amount }}</span> {{ ing.item }}</li>
        {% endfor %}
      </ul>
      <button type="button" class="btn-line grocery-add-btn" id="grocery-add-btn" data-ingredients="{{ recipeContent.ingredients | dump | escape }}">+ Add ingredients to Grocery List</button>
      <p class="grocery-add-confirm" id="grocery-add-confirm" hidden>Added — <a href="/tools/grocery-list.html">view your list</a></p>
    </aside>

    <section class="method">
      <h2>Method</h2>
      <ol>
        {% for step in recipeContent.steps %}
        <li><p>{{ step }}</p></li>
        {% endfor %}
      </ol>
      {% if note %}<div class="note-box">{{ note }}</div>{% endif %}
    </section>
  </div>

  {% if tracking.amazonAssociateTag %}
  <div class="shop-recipe">
    <h2>Shop this recipe</h2>
    <p class="shop-note">As an Amazon Associate, {{ site.title }} earns from qualifying purchases.</p>
    <ul class="shop-links">
      {% for ing in recipeContent.ingredients %}
      <li><a href="https://www.amazon.com/s?k={{ ing.item | urlencode }}&tag={{ tracking.amazonAssociateTag | urlencode }}" target="_blank" rel="nofollow sponsored noopener">{{ ing.item }}</a></li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}
</div>

{% include "partials/footer.njk" %}

<script src="/grocery-list.js"></script>
<script>
(function () {
  var btn = document.getElementById("grocery-add-btn");
  if (!btn) return;
  btn.addEventListener("click", function () {
    var ingredients = [];
    try { ingredients = JSON.parse(btn.getAttribute("data-ingredients") || "[]"); } catch (e) {}
    var lines = ingredients.map(function (i) {
      return [i.amount, i.item].filter(Boolean).join(" ").trim();
    });
    window.DDGroceryList.addItems(lines);
    var confirm = document.getElementById("grocery-add-confirm");
    if (confirm) confirm.hidden = false;
  });
})();
</script>
</body>
</html>
