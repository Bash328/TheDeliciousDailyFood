{%- macro photo(recipe, sizes="(max-width: 560px) 100vw, (max-width: 860px) 50vw, 360px", eager=false) -%}
  {%- if recipe.data.image | imageSrc -%}
    <div class="photo"><img src="{{ recipe.data.image | imageSrc }}" alt="{{ recipe.data.title }}" sizes="{{ sizes }}"{% if eager %} loading="eager" fetchpriority="high"{% endif %}></div>
  {%- endif -%}
{%- endmacro -%}
{#- The optional thumbnail on the right of a list row. Decorative (alt=""), since the
    row's title already names the recipe; renders nothing without a photo. -#}
{%- macro thumb(recipe) -%}
  {%- if recipe.data.image | imageSrc -%}
    <img class="thumb" src="{{ recipe.data.image | imageSrc }}" alt="" sizes="84px" eleventy:widths="168,252" loading="lazy">
  {%- endif -%}
{%- endmacro -%}
{#- "35 min · 4 servings", leaving out whichever half the recipe doesn't have yet
    (a freshly merged submission has neither). -#}
{%- macro meta(recipe) -%}
  {%- set c = recipe.data.recipeContent -%}
  {%- set total = (c.prepTimeMinutes or 0) + (c.cookTimeMinutes or 0) -%}
  {%- if total %}{{ total | minutesLabel }}{% endif -%}
  {%- if total and c.servingsNumber %} · {% endif -%}
  {%- if c.servingsNumber %}{{ c.servingsNumber }} {{ (c.servingsUnit or "servings") | lower }}{% endif -%}
{%- endmacro -%}
