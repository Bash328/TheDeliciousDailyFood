{#- The app-style bottom bar. Hidden except on phones (style.css). The current
    page's tab gets aria-current; recipe pages count as "Recipes". -#}
<nav class="tabbar" aria-label="App">
  <a href="/"{% if page.url == "/" or page.url.startsWith("/recipes/") %} aria-current="page"{% endif %}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v9.5h13V10"/></svg>
    <span>Recipes</span>
  </a>
  <a href="/tools/grocery-list/"{% if page.url == "/tools/grocery-list/" %} aria-current="page"{% endif %}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.5 6H20M9.5 12H20M9.5 18H20"/><path d="m3.5 6 1.2 1.2L6.8 5M3.5 12l1.2 1.2 2.1-2.2M3.5 18l1.2 1.2 2.1-2.2"/></svg>
    <span>Grocery</span>
  </a>
  {%- if site.submitEndpoint %}
  <a href="/submit-recipe/"{% if page.url == "/submit-recipe/" %} aria-current="page"{% endif %}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/></svg>
    <span>Submit</span>
  </a>
  {%- endif %}
  {%- if site.accountsApi %}
  <a href="/account/"{% if page.url == "/account/" %} aria-current="page"{% endif %}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8.5" r="3.5"/><path d="M4.5 20c.8-3.6 3.8-5.5 7.5-5.5s6.7 1.9 7.5 5.5"/></svg>
    <span>Account</span>
  </a>
  {%- endif %}
</nav>
