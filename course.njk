---
layout: layouts/page.njk
pagination:
  data: sections
  size: 1
  alias: section
permalink: "{{ section.id }}/"
eleventyComputed:
  title: "{{ section.heading }} recipes"
  description: "Every {{ section.heading | lower }} recipe on The Delicious Daily, newest first."
eleventyExcludeFromCollections: true
---
{%- from "partials/card.njk" import photo, thumb, meta -%}
<div class="rows">
  {%- for recipe in collections.recipes | byCategories(section.categories) %}
  <a class="row" href="{{ recipe.url }}">
    {%- set noPhoto = not (recipe.data.image | imageSrc) %}
    <div class="row-text">
      {#- A recipe with a photo is just title and time, the thumbnail lining up with the title.
          One without gets a short description, so the row has the same weight. -#}
      <h3>{{ recipe.data.title }}</h3>
      <span class="meta">{{ meta(recipe) }}</span>
      {%- if noPhoto and recipe.data.description %}<p class="excerpt">{{ recipe.data.description }}</p>{% endif %}
    </div>
    {{ thumb(recipe) }}
  </a>
  {%- endfor %}
</div>
