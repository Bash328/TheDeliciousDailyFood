---
permalink: index.html
---
{%- from "partials/card.njk" import photo, meta -%}
{%- set latest = collections.recipes | first -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>{{ site.title }} — Recipes worth saving</title>
<meta name="description" content="Seasonal recipes, tested and photographed for pinning. Weeknight dinners, quiet bakes, and things worth saving.">
<link rel="canonical" href="{{ site.url }}/">
<meta property="og:title" content="{{ site.title }} — Recipes worth saving">
<meta property="og:description" content="Seasonal recipes, tested and photographed for pinning. Weeknight dinners, quiet bakes, and things worth saving.">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.url }}/">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:image" content="{{ site.url }}{{ site.defaultOgImage }}">
<meta property="og:image:alt" content="{{ site.title }} — {{ site.tagline }}">
<meta name="twitter:card" content="summary_large_image">
{% include "partials/head-common.njk" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "WebSite",
  "name": {{ site.title | jsonld | safe }},
  "url": {{ (site.url + "/") | jsonld | safe }},
  "description": "Seasonal recipes, tested and photographed for pinning.",
  "publisher": {
    "@type": "Organization",
    "name": {{ site.title | jsonld | safe }},
    "url": {{ (site.url + "/") | jsonld | safe }},
    "logo": { "@type": "ImageObject", "url": {{ (site.url + site.defaultOgImage) | jsonld | safe }} }
  }
}
</script>
</head>
<body>

<div class="topbar">
  <div class="wrap">
    <a class="brand topbar-brand" href="/">The Delicious <em>Daily</em></a>
    <span class="small-caps topbar-tagline">Recipes tested at home, not in a lab</span>
    <div class="topbar-right">
      <a class="link" href="/tools/grocery-list/">Grocery list</a>
      {% include "partials/theme-toggle.njk" %}
    </div>
  </div>
</div>

<header class="wrap masthead">
  <img class="mark" src="/images/logo-mark-96.png" alt="" width="64" height="64" eleventy:ignore>
  <h1 class="wordmark">The Delicious <em>Daily</em></h1>
  <p class="tagline">{{ site.tagline }}</p>
</header>

<main>
{%- set groups = sections | sectionsWithRecipes(collections.recipes) %}

{% if latest %}
<section class="wrap">
  <a class="featured" href="{{ latest.url }}">
    {{ photo(latest, "(max-width: 860px) 100vw, 700px", true) }}
    <div class="featured-body">
      <div><span class="tag">Latest</span><span class="eyebrow">{{ latest.data.category }}</span></div>
      <div>
        <h2>{{ latest.data.title }}</h2>
        <p class="excerpt">{{ latest.data.description }}</p>
        <p class="meta">{{ meta(latest) }}</p>
      </div>
      <span class="underlink">Get the recipe</span>
    </div>
  </a>
</section>
{% endif %}

<section class="wrap">
  <p class="home-intro">A small, well-tested collection of recipes worth pinning — nothing fussy, nothing you'll scroll past three times looking for the actual ingredients.</p>
</section>

<nav class="home-nav wrap" aria-label="Browse by course">
  <div class="courses">
    {%- for group in groups %}
    <a href="#{{ group.id }}"><span class="num">0{{ loop.index }}</span><span class="name">{{ group.heading }}</span><span class="small-caps">{{ group.items.length }} recipe{% if group.items.length != 1 %}s{% endif %}</span></a>
    {%- endfor %}
  </div>
</nav>

{% for group in groups %}
{%- set lead = group.items | first %}
<section class="wrap course" id="{{ group.id }}">
  <div class="course-head">
    <span class="num">0{{ loop.index }}</span><h2>{{ group.heading }}</h2><span class="small-caps count">{{ group.items.length }} recipe{% if group.items.length != 1 %}s{% endif %}</span>
  </div>
  <div class="course-body">
    <a class="lead" href="{{ lead.url }}">
      {{ photo(lead, "(max-width: 860px) 100vw, 560px") }}
      <h3>{{ lead.data.title }}</h3>
      <span class="meta">{{ meta(lead) }}</span>
    </a>
    {%- if group.items.length > 1 %}
    <div class="rows">
      {%- for recipe in group.items %}{% if not loop.first and loop.index <= 5 %}
      <a class="row" href="{{ recipe.url }}">
        {{ photo(recipe, "96px") }}
        <div><h3>{{ recipe.data.title }}</h3><span class="meta">{{ meta(recipe) }}</span></div>
      </a>
      {%- endif %}{% endfor %}
      {%- if group.items.length > 5 %}
      <a class="underlink" href="/{{ group.id }}/">All {{ group.items.length }} {{ group.heading | lower }} recipes</a>
      {%- endif %}
    </div>
    {%- endif %}
  </div>
</section>
{% endfor %}

{%- if site.submitEndpoint %}
<section class="wrap">
  <div class="cta">
    <div>
      <h2>Got a recipe worth pinning?</h2>
      <p>Send it in and it could land on the next page.</p>
    </div>
    <a class="btn btn-solid" href="/submit-recipe/">Submit a recipe</a>
  </div>
</section>
{%- endif %}
</main>

{% include "partials/footer.njk" %}

<script>
// Highlights the category chip for the section on screen, and keeps it in view.
(function () {
  var chips = document.querySelectorAll(".courses a");
  if (!chips.length || !("IntersectionObserver" in window)) return;
  var byId = {};
  chips.forEach(function (a) { byId[a.getAttribute("href").slice(1)] = a; });
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (!e.isIntersecting) return;
      chips.forEach(function (a) { a.removeAttribute("aria-current"); });
      var chip = byId[e.target.id];
      if (chip) {
        chip.setAttribute("aria-current", "true");
        chip.scrollIntoView({ block: "nearest", inline: "center" });
      }
    });
  }, { rootMargin: "-30% 0px -65% 0px" });
  document.querySelectorAll(".course").forEach(function (s) { io.observe(s); });
})();
</script>
{% include "partials/sprinkles.njk" %}
</body>
</html>
