---
permalink: index.html
---
{%- from "partials/card.njk" import photo -%}
{%- set latest = collections.recipes | first -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ site.title }} — Recipes worth saving</title>
<meta name="description" content="Seasonal recipes, tested and photographed for pinning. Weeknight dinners, quiet bakes, and things worth saving.">
<link rel="canonical" href="{{ site.url }}/">
<meta property="og:title" content="{{ site.title }} — Recipes worth saving">
<meta property="og:description" content="Seasonal recipes, tested and photographed for pinning. Weeknight dinners, quiet bakes, and things worth saving.">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.url }}/">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:image" content="{{ site.url }}{{ site.defaultOgImage }}">
<meta property="og:image:alt" content="{{ site.title }} — {{ site.tagline }}">
<meta name="twitter:card" content="summary_large_image">
{% include "partials/head-common.njk" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "WebSite",
  "name": {{ site.title | jsonld | safe }},
  "url": {{ (site.url + "/") | jsonld | safe }},
  "description": "Seasonal recipes, tested and photographed for pinning.",
  "publisher": {
    "@type": "Organization",
    "name": {{ site.title | jsonld | safe }},
    "url": {{ (site.url + "/") | jsonld | safe }},
    "logo": { "@type": "ImageObject", "url": {{ (site.url + site.defaultOgImage) | jsonld | safe }} }
  }
}
</script>
</head>
<body>

{% include "partials/theme-toggle.njk" %}

<header class="site-header">
  <div class="wrap">
    <img class="mark" src="/images/logo-mark-96.png" alt="" width="40" height="40" eleventy:ignore>
    <h1 class="site-title">{{ site.title }}</h1>
    <p class="sub">{{ site.tagline }}</p>
  </div>
  <nav class="site-nav wrap" aria-label="Recipe categories">
    {% for section in sections %}<a href="#{{ section.id }}">{{ section.heading }}</a>{% endfor %}
    <a class="nav-action" href="/tools/grocery-list/">Grocery List</a>
    {%- if site.submitEndpoint %}
    <a class="nav-action is-primary" href="/submit-recipe/">Submit a Recipe</a>
    {%- endif %}
  </nav>
</header>

<main class="wrap">

  <p class="intro">A small, well-tested collection of recipes worth pinning — nothing fussy, nothing you'll scroll past three times looking for the actual ingredients.</p>

  {% if latest %}
  <a class="hero-post" href="{{ latest.url }}">
    {{ photo(latest, "(max-width: 800px) 100vw, 600px", true) }}
    <div>
      <span class="eyebrow">Latest · {{ latest.data.category }}</span>
      <h2>{{ latest.data.title }}</h2>
      <p class="excerpt">{{ latest.data.description }}</p>
      <span class="btn-line">Read the recipe</span>
    </div>
  </a>
  {% endif %}

  {% for section in sections %}
  {%- set items = collections.recipes | byCategories(section.categories) -%}
  {% if items.length %}
  <div class="section-head" id="{{ section.id }}">
    <h2>{{ section.heading }}</h2>
    <hr class="rule" style="flex:1; margin: 0 20px;">
  </div>
  <div class="grid">
    {% for recipe in items %}
    <a class="card" href="{{ recipe.url }}">
      {{ photo(recipe) }}
      <span class="cat">{{ recipe.data.category }}</span>
      <h3>{{ recipe.data.title }}</h3>
      <p class="excerpt">{{ recipe.data.description }}</p>
      <span class="meta">{{ (recipe.data.recipeContent.prepTimeMinutes + recipe.data.recipeContent.cookTimeMinutes) | minutesLabel }} · {{ recipe.data.recipeContent.servingsNumber }} {{ recipe.data.recipeContent.servingsUnit | lower }}</span>
    </a>
    {% endfor %}
  </div>
  {% endif %}
  {% endfor %}

</main>

{% include "partials/footer.njk" %}
{% include "partials/sprinkles.njk" %}
</body>
</html>
